[Unit]
Description=Reviewer model server (llama-server)
After=network.target

[Service]
EnvironmentFile=/etc/memory-agent/llama-gpt.env
ExecStartPre=/usr/bin/test -s /opt/models/${MODEL}
ExecStart=/opt/llama.cpp/build/bin/llama-server -m /opt/models/${MODEL} -t ${THREADS} -c ${CTX} -np ${PARALLEL} $EXTRA --kv-unified --jinja --host 127.0.0.1 --port 8081
Restart=on-failure
Nice=10

[Install]
WantedBy=multi-user.target
