[Unit]
Description=Curator model server (started and stopped by the curator)
After=network.target

[Service]
EnvironmentFile=/etc/memory-agent/llama-cur.env
ExecStartPre=/usr/bin/test -s /opt/models/${MODEL}
ExecStart=/opt/llama.cpp/build/bin/llama-server -m /opt/models/${MODEL} -t ${THREADS} -c ${CTX} -np ${PARALLEL} $EXTRA --kv-unified --jinja --host 127.0.0.1 --port 8082
Restart=on-failure
Nice=15
