[Unit]
Description=Sweeper model server (llama-server)
After=network.target

[Service]
EnvironmentFile=/etc/memory-agent/llama-qwen.env
ExecStartPre=/usr/bin/test -s /opt/models/${MODEL}
ExecStart=/opt/llama.cpp/build/bin/llama-server -m /opt/models/${MODEL} -t ${THREADS} -c ${CTX} -np ${PARALLEL} $EXTRA --kv-unified --host 127.0.0.1 --port 8080
Restart=on-failure
Nice=5

[Install]
WantedBy=multi-user.target
