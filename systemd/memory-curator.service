[Unit]
Description=Curator (reviews notes in depth when its model has its turn)
After=network.target

[Service]
WorkingDirectory=/opt/memory-agent
ExecStart=/opt/memory-agent/venv/bin/python curator.py --watch
Restart=on-failure
RestartSec=30
TimeoutStopSec=1500
Nice=19

[Install]
WantedBy=multi-user.target
